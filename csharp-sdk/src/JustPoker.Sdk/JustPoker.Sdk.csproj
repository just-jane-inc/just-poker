<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <LangVersion>latest</LangVersion>
        <Nullable>enable</Nullable>
        <ImplicitUsings>enable</ImplicitUsings>
        <RootNamespace>JustPoker.Sdk</RootNamespace>
        <AssemblyName>JustPoker.Sdk</AssemblyName>
        <GenerateDocumentationFile>true</GenerateDocumentationFile>
        <NoWarn>$(NoWarn);CS1591</NoWarn>

        <PackageId>JustPoker.Sdk</PackageId>
        <IsPackable>true</IsPackable>
        <TargetsForTfmSpecificBuildOutput>$(TargetsForTfmSpecificBuildOutput);IncludeReferencedProjectsInPackage</TargetsForTfmSpecificBuildOutput>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" Version="10.0.6"/>
        <PackageReference Include="Microsoft.Extensions.Http" Version="10.0.1"/>
        <PackageReference Include="Microsoft.Extensions.Hosting" Version="10.0.1"/>
        <PackageReference Include="Microsoft.Extensions.Http.Polly" Version="10.0.1"/>
        <PackageReference Include="Microsoft.Net.Http.Headers" Version="10.0.1"/>
    </ItemGroup>
    <ItemGroup>
        <ProjectReference Include="../../generated/src/JustPoker.OpenApi/JustPoker.OpenApi.csproj" PrivateAssets="all"/>
    </ItemGroup>

    <Target Name="IncludeReferencedProjectsInPackage" DependsOnTargets="ResolveReferences">
        <ItemGroup>
            <BuildOutputInPackage Include="@(ReferenceCopyLocalPaths->WithMetadataValue('ReferenceSourceTarget', 'ProjectReference'))"/>
        </ItemGroup>
    </Target>

</Project>
